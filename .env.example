# Nrova Support Desk (crm:support) — never commit real keys
# Put this file in the repo root (next to package.json). Restart `npm run dev` after editing.
#
# Value must be the raw secret (starts with nrov_live_…). The 64-char hex in the Nrova UI is
# only a hash of the key — it will not work as Bearer / X-Api-Key. No space after =.
NROVA_SUPPORT_API_KEY=

# Optional: same secret under this name if your host already defines it
# NROVA_API_KEY=

# Optional overrides (defaults match your org)
# NROVA_SUPPORT_API_BASE_URL=https://us-central1-nrovallc.cloudfunctions.net/crmSupportApi
# NROVA_ORGANIZATION_ID=DmByfTTUdCs0ecp2MMoQ
# NROVA_APPLICATION_NAME=Anthony Silvia Portfolio

# NodeDa Resume Embed API (nrova.resume.public.v1)
# Production default: https://resume.nodeda.com
# Local Resume host (when Nrova Resume is running): http://resume.localhost:3000
# NEXT_PUBLIC_RESUME_SITE_URL=https://resume.nodeda.com
# Opaque share token from Resume → Editor → Share link (nrv_rsm_…)
# NEXT_PUBLIC_RESUME_SHARE_TOKEN=nrv_rsm_…